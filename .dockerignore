# AGGRESSIVE EXCLUSION for minimal Docker builds
# ONLY include: pyproject.toml, backend/app/, and essential files

# Ignore EVERYTHING first
*

# Then ONLY include what we need
!pyproject.toml
!backend/
backend/*
!backend/app/
!backend/app/**

# Exclude ALL other directories completely  
tests/
info/
scripts/
.github/
.vscode/
.git/

# Exclude ALL documentation 
*.md
*.txt
*.rst

# Exclude ALL development files
*.env
*.secret
*.key
*.pyc
*.pyo
*.pyd
__pycache__/
.pytest_cache/

# Exclude ALL media and binaries
*.mp4
*.png
*.jpg
*.jpeg
*.gif
*.tgz
*.tar.gz
*.zip
*.sh

# Exclude lock files
uv.lock